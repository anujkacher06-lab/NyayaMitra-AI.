# NyayaMitra AI Configuration
# Optional: Provide Google Gemini API Key or OpenAI API Key
# If omitted, NyayaMitra automatically uses the local verified deterministic RAG engine!
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Telegram Bot Integration (Optional)
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
PORT=5000
FLASK_ENV=development
